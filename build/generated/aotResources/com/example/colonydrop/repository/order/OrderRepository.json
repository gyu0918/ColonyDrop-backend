  "methods": [
    {
      "name": "findByBuyerMemberId",
      "signature": "public abstract java.util.List<com.example.colonydrop.entity.order.Order> com.example.colonydrop.repository.order.OrderRepository.findByBuyerMemberId(java.lang.String)",
      "query": {
        "query": "SELECT o FROM Order o JOIN FETCH o.item WHERE o.buyer.memberId = :memberId ORDER BY o.createdAt DESC"
      }
    },
    {
      "name": "findByImpUid",
      "signature": "public abstract java.util.Optional<com.example.colonydrop.entity.order.Order> com.example.colonydrop.repository.order.OrderRepository.findByImpUid(java.lang.String)",
      "query": {
        "query": "SELECT o FROM Order o JOIN FETCH o.item JOIN FETCH o.buyer WHERE o.impUid = :impUid"
      }
    },
    {
      "name": "findByMerchantUid",
      "signature": "public abstract java.util.Optional<com.example.colonydrop.entity.order.Order> com.example.colonydrop.repository.order.OrderRepository.findByMerchantUid(java.lang.String)",
      "query": {
        "query": "SELECT o FROM Order o JOIN FETCH o.item JOIN FETCH o.buyer WHERE o.merchantUid = :merchantUid"
      }
    },
    {
      "name": "findByMerchantUidAndBuyerMemberId",
      "signature": "public abstract java.util.Optional<com.example.colonydrop.entity.order.Order> com.example.colonydrop.repository.order.OrderRepository.findByMerchantUidAndBuyerMemberId(java.lang.String,java.lang.String)",
      "query": {
        "query": "SELECT o FROM Order o JOIN FETCH o.item JOIN FETCH o.buyer WHERE o.merchantUid = :merchantUid AND o.buyer.memberId = :memberId"
      }
    },
    {
      "name": "findExpiredOrders",
      "signature": "public abstract java.util.List<com.example.colonydrop.entity.order.Order> com.example.colonydrop.repository.order.OrderRepository.findExpiredOrders(java.time.LocalDateTime)",
      "query": {
        "query": "SELECT o FROM Order o JOIN FETCH o.item WHERE o.status IN ('PENDING', 'RESERVED') AND o.createdAt < :expireTime"
      }
    },
